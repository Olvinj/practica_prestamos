<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="prestamo_equipo_view_kanban" model="ir.ui.view">
        <field name="name">prestamo.equipo.kanban</field>
        <field name="model">prestamo.equipo</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado" records_draggable="0">
                <field name="name"/>
                <field name="codigo"/>
                <field name="categoria"/>
                <field name="estado"/>
                <field name="veces_prestado"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="fw-bold"><field name="name"/></div>
                            <div><field name="codigo"/></div>
                            <div><field name="categoria"/></div>
                            <div>Veces prestado: <field name="veces_prestado"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="prestamo_equipo_view_list" model="ir.ui.view">
        <field name="name">prestamo.equipo.list</field>
        <field name="model">prestamo.equipo</field>
        <field name="arch" type="xml">
            <list>
                <field name="codigo"/>
                <field name="name"/>
                <field name="categoria"/>
                <field name="estado"/>
                <field name="veces_prestado"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="prestamo_equipo_view_form" model="ir.ui.view">
        <field name="name">prestamo.equipo.form</field>
        <field name="model">prestamo.equipo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_enviar_mantenimiento" string="Enviar a mantenimiento"
                            type="object" class="btn-secondary"
                            invisible="estado == 'prestado' or estado == 'mantenimiento'"/>
                    <button name="action_marcar_disponible" string="Marcar disponible"
                            type="object" class="btn-primary"
                            invisible="estado == 'disponible'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="codigo"/>
                        </group>
                        <group>
                            <field name="categoria"/>
                            <field name="estado"/>
                            <field name="active"/>
                            <field name="veces_prestado"/>
                        </group>
                    </group>
                    <field name="notas" placeholder="Accesorios, estado físico..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="prestamo_equipo_action" model="ir.actions.act_window">
        <field name="name">Equipos</field>
        <field name="res_model">prestamo.equipo</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="prestamo_menu_root" name="Préstamos" sequence="60"/>
    <menuitem id="prestamo_equipo_menu" name="Equipos"
              parent="prestamo_menu_root" action="prestamo_equipo_action" sequence="20"/>
</odoo>
